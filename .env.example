# ChipForge SN108: validator / miner settings.
#   cp .env.example .env    then fill in the "required" values.
# Read by start_validator.sh / start_miner.sh / submit_solution.sh, by the Python code
# (python-dotenv), and by docker compose (`make up`). Never commit .env.
# Values are plain KEY=value; keep comments on their own line.

# =====================================================================================
# Chain (required)
# =====================================================================================
# 108 on mainnet (finney); your test subnet's netuid on testnet
NETUID=108
# finney | test | local
SUBTENSOR_NETWORK=finney
# Optional: your own subtensor node, e.g. ws://127.0.0.1:9944 (overrides the network's default endpoint)
SUBTENSOR_CHAIN_ENDPOINT=

# =====================================================================================
# Wallets (required)
# =====================================================================================
# A wallet lives at <WALLET_DIR>/<WALLET_NAME>/hotkeys/<HOTKEY>. The validator and the miner
# have separate settings, so both can run from this folder with different wallets.
# WALLET_NAME is the wallet folder's name, not a path.

# Validator (make up, start_validator.sh)
VALIDATOR_WALLET_DIR=~/.bittensor/wallets
VALIDATOR_WALLET_NAME=
VALIDATOR_HOTKEY=default

# Miner (make up ROLE=miner, start_miner.sh, miner_cli.py, make submit)
MINER_WALLET_DIR=~/.bittensor/wallets
MINER_WALLET_NAME=
MINER_HOTKEY=default

# =====================================================================================
# Challenge server
# =====================================================================================
CHALLENGE_API_URL=https://api.chipforge.io
# Validators only: issued by the ChipForge team. Read from here, never pass it on the command line.
VALIDATOR_SECRET_KEY=
# Request signing: both (v1 + v2, default), v2, or v1 (older servers only)
SIGNATURE_MODE=v2

# =====================================================================================
# Validator: rewards
# =====================================================================================
# Share of emissions for the current winner, in percent; the rest is burned to UID 0.
# If the challenge server sets MINER_EMISSION_PERCENTAGE, its value is used instead of this one.
MINER_EMISSION_PERCENTAGE=10
# Hours the winner of a challenge keeps being rewarded (the server may override; capped below)
TOTAL_HOURS_FOR_WINNER_REWARD=24
# Upper bound accepted from the server for winner_reward_hours
MAX_WINNER_REWARD_HOURS=24
# A new winner must beat the score to beat by this many percent (0 = any higher score).
# Fallback only: the challenge server sends the margin in force (0 until a challenge's first
# winner, its MIN_IMPROVEMENT_PERCENT after) and the validator uses that instead.
MIN_IMPROVEMENT_PERCENT=20
# Days to keep burning after the reward window ends (0 = none)
BURN_AFTER_WINNER_DAYS=0
# Re-submit unchanged weights at least this often (seconds); new winners go out immediately
WEIGHTS_REFRESH_SECONDS=300
METAGRAPH_SYNC_SECONDS=600
# How often the log shows the weights on chain and the weights this validator wants (seconds)
WEIGHT_STATUS_SECONDS=180

# =====================================================================================
# Validator: evaluation (EDA server)
# =====================================================================================
# The EDA gateway (runs without an API key: keep port 8080 closed to the internet)
EDA_SERVER_URL=http://localhost:8080
# How many submissions this validator sends to its EDA server at the same time. This is NOT the
# batch size: the challenge server decides how many submissions are in a batch, and every one of
# them is evaluated; this only paces them for your EDA machine (whose own lanes queue the rest).
EDA_MAX_CONCURRENCY=8
# Stop waiting for EDA results this many seconds before the batch's evaluation deadline
EDA_DEADLINE_BUFFER_SECONDS=30
# Skip a batch if less than this is left of its evaluation window
MIN_BATCH_SECONDS=0
# Seconds to wait for miners to acknowledge notifications
MINER_NOTIFY_TIMEOUT=12
# Testing only: fake scores instead of calling the EDA server
USE_DUMMY_EVALUATION=false

# =====================================================================================
# Miner
# =====================================================================================
# Axon port (must be reachable from the internet)
AXON_PORT=8091
# How often to check the challenge server for a new challenge; validator notices trigger an immediate check
MINER_POLL_SECONDS=300
# Where challenge packages are extracted (Docker: inside DATA_DIR)
MINER_CHALLENGE_DIR=./downloaded_active_challenge
# Answer only validators with a validator permit (false = any registered hotkey)
MINER_REQUIRE_VALIDATOR_PERMIT=true
MINER_MAX_CHALLENGE_MB=200
MINER_MAX_EXTRACTED_MB=1024
MINER_MAX_ZIP_MEMBERS=10000
# submit_solution.sh / make submit: the ZIP to upload
FILE_TO_SUBMIT=
# Client-side size check; the server's limit is 50 MB
MAX_SUBMISSION_SIZE_MB=50

# =====================================================================================
# Storage and runtime
# =====================================================================================
# State, downloads and logs. Bare-metal default: the repo directory. Docker: the host
# directory mounted at /data (DATA_DIR, default ./data).
CHIPFORGE_DATA_DIR=.
DATA_DIR=./data
# Liveness file interval used by the Docker healthcheck
HEARTBEAT_SECONDS=30
# bittensor log level for the neurons: info | debug | trace
BT_LOG_LEVEL=info
